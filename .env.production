# TTI PDF — production branding + remote LibreOffice WASM via Cloudflare R2
# Generated on tti/branding-loff-hosting branch
# See scripts/sync-loff-to-r2.mjs for how to populate the R2 bucket.

VITE_BRAND_NAME=TTi Secure PDF Editor
VITE_BRAND_LOGO=images/tti-mark.svg
VITE_FOOTER_TEXT=© 2026 TTI PDF. All rights reserved.

# Remote LibreOffice WASM base — must end with trailing slash
# 1. Create bucket:  npx wrangler r2 bucket create tti-pdf-loff
# 2. Upload files:   node scripts/sync-loff-to-r2.mjs --bucket tti-pdf-loff
# 3. Enable public:  npx wrangler r2 bucket update tti-pdf-loff --public  (or attach custom domain)
# 4. Set this URL to your public R2 URL (r2.dev or custom domain cdn.ttipdf.com)
VITE_LIBREOFFICE_BASE_URL=https://pub-b81b35f45d324dc996f144ac90cea29f.r2.dev/libreoffice-wasm/

# Keep CDN for other WASMs (PyMuPDF etc.)
VITE_WASM_PYMUPDF_URL=https://cdn.jsdelivr.net/npm/@bentopdf/pymupdf-wasm@0.11.16/
VITE_WASM_GS_URL=https://cdn.jsdelivr.net/npm/@bentopdf/gs-wasm@0.1.1/assets/
VITE_WASM_CPDF_URL=https://cdn.jsdelivr.net/npm/coherentpdf@2.5.5/dist/
VITE_USE_CDN=true

SITE_URL=https://pdf.tti-research.com
